<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <AssemblyName>PackageStack.Module</AssemblyName>
        <LangVersion>13</LangVersion>
        <Nullable>enable</Nullable>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
        <ModuleName>PackageStack</ModuleName>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
        <PackageReference Include="PowerShellStandard.Library" Version="5.1.0-preview-06">
            <PrivateAssets>All</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\PackageStack.Common\PackageStack.Common.csproj" />
    </ItemGroup>
    
    <Target Name="CopyModuleManifest" AfterTargets="Build">
        <PropertyGroup>
            <ModuleManifestPath>$(MSBuildProjectDirectory)\$(ModuleName).psd1</ModuleManifestPath>
            <ModuleOutputDirectory>$(OutDir)</ModuleOutputDirectory>
        </PropertyGroup>
        <Copy SourceFiles="$(ModuleManifestPath)" DestinationFolder="$(ModuleOutputDirectory)" SkipUnchangedFiles="true" />
    </Target>

</Project>
